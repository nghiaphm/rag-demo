# ===== LLM (OpenRouter) =====
# OpenRouter là gateway truy cập nhiều chat model qua 1 API key.
OPENROUTER_API_KEY=sk-or-xxxxxxxxxxxxxxxxxxxxxxxx
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
LLM_MODEL=anthropic/claude-sonnet-4.5

# ===== Embedding provider (độc lập với LLM) =====
# Provider/model có thể thay đổi mà không sửa RAG pipeline.
EMBEDDING_PROVIDER=openai
EMBEDDING_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxx
EMBEDDING_MODEL=text-embedding-3-small

# ===== Chunking =====
CHUNK_SIZE=500
CHUNK_OVERLAP=50

# ===== Retrieval =====
TOP_K=5

# ===== Storage (PostgreSQL + pgvector) =====
DATABASE_URL=postgresql+psycopg://rag:rag_password@localhost:5433/rag
DOCUMENTS_DIR=./data/documents
