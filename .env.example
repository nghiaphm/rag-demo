# ===== LLM (Groq qua OpenAI-compatible API) =====
GROQ_API_KEY=gsk_xxxxxxxxxxxxxxxxxxxxxxxx
OPENAI_BASE_URL=https://api.groq.com/openai/v1
# Dùng model đang được Groq hỗ trợ cho tier của tài khoản.
LLM_MODEL=openai/gpt-oss-120b
LLM_REQUEST_TIMEOUT_SECONDS=60.0
LLM_MAX_RETRIES=2

# ===== Tool Use: JSON /chat only (SSE remains legacy) =====
# Keep disabled until configured Groq/model capabilities are separately verified.
TOOL_USE_ENABLED=false

# ===== History-aware context budget =====
# Tổng 5 allocation bên dưới không được vượt RAG_CONTEXT_WINDOW_TOKENS.
RAG_CONTEXT_WINDOW_TOKENS=8192
RAG_SYSTEM_MAX_TOKENS=1024
RAG_HISTORY_MAX_TOKENS=2048
RAG_CHUNKS_MAX_TOKENS=3584
RAG_QUERY_MAX_TOKENS=512
RAG_OUTPUT_RESERVE_TOKENS=1024
# Bộ đếm xấp xỉ; 3 chars/token bảo thủ hơn default tiếng Anh cho text đa ngôn ngữ.
RAG_TOKEN_CHARS_PER_TOKEN=3.0
RAG_REWRITE_TIMEOUT_SECONDS=15.0
RAG_REWRITE_MAX_CHARS=1000

# ===== Embedding provider (độc lập với LLM) =====
# Baseline: Google Gemini embedding, free tier (Gemini Developer API / Google AI Studio).
# Lấy API key dạng AIza... tại https://aistudio.google.com/apikey
EMBEDDING_PROVIDER=google
EMBEDDING_API_KEY=AIza-xxxxxxxxxxxxxxxxxxxxxxxx
EMBEDDING_MODEL=gemini-embedding-001
EMBEDDING_TIMEOUT_SECONDS=30.0

# ===== Chunking =====
CHUNK_SIZE=500
CHUNK_OVERLAP=50

# ===== Retrieval & Reranking =====
TOP_K=5
RERANKER_ENABLED=false
RERANKER_PROVIDER=flashrank
RERANKER_MODEL=ms-marco-TinyBERT-L-2-v2
RERANKER_CANDIDATE_TOP_K=15
RERANKER_RELEVANCE_THRESHOLD=0.0
# COHERE_API_KEY=your-cohere-api-key

# ===== Hybrid Search (Dense Vector + BM25 Keyword) =====
HYBRID_SEARCH_ENABLED=false
HYBRID_RRF_K=60

# ===== SSE streaming =====
# Total provider-stream deadline; must be greater than 0.
STREAM_TIMEOUT_SECONDS=120.0

# ===== Tool orchestration & limits =====
TOOL_SELECTOR_TIMEOUT_SECONDS=15.0
CHAT_TURN_TIMEOUT_SECONDS=120.0
CHAT_MAX_ANSWER_CHARS=1000000

# ===== Raw-file storage =====
DOCUMENTS_DIR=./data/documents
STORAGE_BACKEND=local
MAX_UPLOAD_BYTES=26214400
DEFAULT_TENANT_ID=default
# Cấu hình khi STORAGE_BACKEND=s3 (credential ingestion dùng quyền ghi):
# S3_BUCKET=your-rag-documents-bucket
# S3_REGION=ap-southeast-1
# S3_ENDPOINT_URL=https://s3.ap-southeast-1.amazonaws.com
# S3_INGEST_ACCESS_KEY_ID=replace-with-ingest-access-key
# S3_INGEST_SECRET_ACCESS_KEY=replace-with-ingest-secret-key
# S3_USE_IF_NONE_MATCH=true

# ===== Excel Parquet & Table Catalog Ingestion =====
EXCEL_PARQUET_INGESTION_ENABLED=false
EXCEL_CATALOG_SAMPLE_ROWS=3

# ===== DuckDB SQL Query Executor (S3 Read-Only) =====
# Credential query bắt buộc phải KHÁC credential ingestion (chỉ cấp quyền s3:GetObject trên */tables/*.parquet)
# S3_QUERY_ACCESS_KEY_ID=replace-with-readonly-query-access-key
# S3_QUERY_SECRET_ACCESS_KEY=replace-with-readonly-query-secret-key
DUCKDB_MEMORY_LIMIT=512MB
DUCKDB_THREADS=2
DUCKDB_QUERY_TIMEOUT_SECONDS=15.0
DUCKDB_MAX_ROWS=200

# ===== Excel SQL Chat Integration & Selective Text-Only Embedding =====
# Khi EXCEL_SQL_ENABLED=true, bắt buộc AGENTIC_MODE_ENABLED=true, STORAGE_BACKEND=s3 và EXCEL_PARQUET_INGESTION_ENABLED=true.
EXCEL_SQL_ENABLED=false
# Khi EXCEL_TEXT_ONLY_EMBEDDING_ENABLED=true, bắt buộc EXCEL_PARQUET_INGESTION_ENABLED=true.
EXCEL_TEXT_ONLY_EMBEDDING_ENABLED=false
EXCEL_SENSITIVE_COLUMN_PATTERNS=luong,salary,thu_nhap,cmnd,cccd,passport,so_tai_khoan,bank,mat_khau,password,token,ma_so_thue,dia_chi,so_dien_thoai

# ===== Application database (MongoDB Atlas) =====
# Chỉ dùng placeholder trong file này; không commit URI thật.
MONGODB_URI=mongodb+srv://username:password@cluster.example.mongodb.net/?retryWrites=true&w=majority
MONGODB_DB_NAME=rag_demo
MONGODB_TIMEOUT_MS=5000

# ===== Vector database đích (Qdrant Cloud) =====
# Chỉ dùng placeholder trong file này; endpoint cloud phải dùng HTTPS.
QDRANT_URL=https://cluster-id.region.cloud.qdrant.io:6333
QDRANT_API_KEY=replace-with-qdrant-api-key
QDRANT_COLLECTION=rag_documents
QDRANT_TIMEOUT_SECONDS=5.0

# ===== Observability (Langfuse) =====
LANGFUSE_ENABLED=false
# LANGFUSE_PUBLIC_KEY=pk-lf-xxxxxxxxxxxxxxxx
# LANGFUSE_SECRET_KEY=sk-lf-xxxxxxxxxxxxxxxx
LANGFUSE_HOST=https://cloud.langfuse.com

# ===== Corrective RAG (Phase 2) =====
CORRECTIVE_RAG_ENABLED=false
CORRECTIVE_MAX_RETRIES=1
CORRECTIVE_GRADER_MODEL=llama-3.1-8b-instant
WEB_SEARCH_FALLBACK_ENABLED=false
# TAVILY_API_KEY=tvly-xxxxxxxxxxxxxxxx

# ===== Agentic Orchestration (Phase 3) =====
AGENTIC_MODE_ENABLED=false
MAX_AGENT_STEPS=4

# ===== Auth, RBAC, Semantic Cache & Rate Limiting (Phase 4) =====
AUTH_ENABLED=false
JWT_SECRET_KEY=replace-with-strong-random-secret
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30
JWT_REFRESH_TOKEN_EXPIRE_MINUTES=10080
SEMANTIC_CACHE_ENABLED=false
SEMANTIC_CACHE_SIMILARITY_THRESHOLD=0.95
SEMANTIC_CACHE_TTL_SECONDS=3600
REDIS_URL=redis://localhost:6379/0
RATE_LIMIT_ENABLED=false
RATE_LIMIT_REQUESTS_PER_MINUTE=60
TRUSTED_PROXY_IPS=
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
MAX_TOKENS_PER_TURN=8192

# ===== Async Ingestion Worker (Phase 5.1) =====
ASYNC_INGESTION_ENABLED=false
