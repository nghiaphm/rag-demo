# ===== LLM (OpenRouter) =====
# OpenRouter là gateway truy cập nhiều chat model qua 1 API key.
OPENROUTER_API_KEY=sk-or-xxxxxxxxxxxxxxxxxxxxxxxx
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
LLM_MODEL=nvidia/nemotron-3-super-120b-a12b:free

# ===== Embedding provider (độc lập với LLM) =====
# Baseline: Google Gemini embedding, free tier (Gemini Developer API / Google AI Studio).
# Lấy API key dạng AIza... tại https://aistudio.google.com/apikey
EMBEDDING_PROVIDER=google
EMBEDDING_API_KEY=AIza-xxxxxxxxxxxxxxxxxxxxxxxx
EMBEDDING_MODEL=gemini-embedding-001

# ===== Chunking =====
CHUNK_SIZE=500
CHUNK_OVERLAP=50

# ===== Retrieval =====
TOP_K=5

# ===== Storage (PostgreSQL + pgvector) =====
DATABASE_URL=postgresql+psycopg://rag:rag_password@localhost:5433/rag
DOCUMENTS_DIR=./data/documents
