# ===== LLM (Groq qua OpenAI-compatible API) =====
GROQ_API_KEY=gsk_xxxxxxxxxxxxxxxxxxxxxxxx
OPENAI_BASE_URL=https://api.groq.com/openai/v1
# Dùng model đang được Groq hỗ trợ cho tier của tài khoản.
LLM_MODEL=openai/gpt-oss-120b

# ===== Tool Use: JSON /chat only (SSE remains legacy) =====
# Keep disabled until configured Groq/model capabilities are separately verified.
TOOL_USE_ENABLED=false

# ===== History-aware context budget =====
# Tổng 5 allocation bên dưới không được vượt RAG_CONTEXT_WINDOW_TOKENS.
RAG_CONTEXT_WINDOW_TOKENS=8192
RAG_SYSTEM_MAX_TOKENS=1024
RAG_HISTORY_MAX_TOKENS=2048
RAG_CHUNKS_MAX_TOKENS=3584
RAG_QUERY_MAX_TOKENS=512
RAG_OUTPUT_RESERVE_TOKENS=1024
# Bộ đếm xấp xỉ; 3 chars/token bảo thủ hơn default tiếng Anh cho text đa ngôn ngữ.
RAG_TOKEN_CHARS_PER_TOKEN=3.0
RAG_REWRITE_TIMEOUT_SECONDS=15.0
RAG_REWRITE_MAX_CHARS=1000

# ===== Embedding provider (độc lập với LLM) =====
# Baseline: Google Gemini embedding, free tier (Gemini Developer API / Google AI Studio).
# Lấy API key dạng AIza... tại https://aistudio.google.com/apikey
EMBEDDING_PROVIDER=google
EMBEDDING_API_KEY=AIza-xxxxxxxxxxxxxxxxxxxxxxxx
EMBEDDING_MODEL=gemini-embedding-001

# ===== Chunking =====
CHUNK_SIZE=500
CHUNK_OVERLAP=50

# ===== Retrieval & Reranking =====
TOP_K=5
RERANKER_ENABLED=false
RERANKER_PROVIDER=flashrank
RERANKER_MODEL=ms-marco-TinyBERT-L-2-v2
RERANKER_CANDIDATE_TOP_K=15
RERANKER_RELEVANCE_THRESHOLD=0.0
# COHERE_API_KEY=your-cohere-api-key

# ===== SSE streaming =====
# Total provider-stream deadline; must be greater than 0.
STREAM_TIMEOUT_SECONDS=120.0

# ===== Tool orchestration & limits =====
TOOL_SELECTOR_TIMEOUT_SECONDS=15.0
CHAT_TURN_TIMEOUT_SECONDS=120.0
CHAT_MAX_ANSWER_CHARS=1000000

# ===== Raw-file storage =====
DOCUMENTS_DIR=./data/documents
STORAGE_BACKEND=local

# ===== Application database (MongoDB Atlas) =====
# Chỉ dùng placeholder trong file này; không commit URI thật.
MONGODB_URI=mongodb+srv://username:password@cluster.example.mongodb.net/?retryWrites=true&w=majority
MONGODB_DB_NAME=rag_demo
MONGODB_TIMEOUT_MS=5000

# ===== Vector database đích (Qdrant Cloud) =====
# Chỉ dùng placeholder trong file này; endpoint cloud phải dùng HTTPS.
QDRANT_URL=https://cluster-id.region.cloud.qdrant.io:6333
QDRANT_API_KEY=replace-with-qdrant-api-key
QDRANT_COLLECTION=rag_documents
QDRANT_TIMEOUT_SECONDS=5.0
