import type { Page } from "@playwright/test"
import { test, expect } from "./fixtures.mjs"

const documentId = "11111111-1111-4111-8111-111111111111"
const filename = "so-tay-nhan-vien.pdf"
const detail = (page: Page) => page.getByRole("region", { name: "Chi tiết tài liệu", exact: true })
const activeId = (page: Page) => detail(page).locator("dt").filter({ hasText: /^Active version ID$/ }).locator("..").locator("dd")
const confirm = (page: Page) => page.getByRole("button", { name: "Xác nhận thao tác", exact: true })
const syntheticFile = (name: string, content = "synthetic document QA\n") => ({ name, mimeType: "text/plain", buffer: Buffer.from(content) })
async function openDocument(page: Page) {
  await page.goto("/documents")
  await page.getByRole("button", { name: new RegExp(filename.replaceAll(".", "\\.")) }).click()
  await expect(activeId(page)).toHaveText("11111111-1111-4111-8111-111111111102")
}

test("upload keyboard focus trap, invalid files, Escape cancellation and no mutation", async ({ page, qa }) => {
  await page.goto("/documents")
  const trigger = page.getByRole("button", { name: "Thêm tài liệu", exact: true })
  await trigger.focus(); await page.keyboard.press("Enter")
  const dialog = page.getByRole("dialog", { name: "Thêm tài liệu", exact: true })
  const file = dialog.getByLabel("File tài liệu", { exact: true })
  await expect(file).toBeFocused()
  await page.keyboard.press("Shift+Tab")
  await expect(dialog.getByRole("button", { name: "Close", exact: true })).toBeFocused()
  await page.keyboard.press("Tab"); await expect(file).toBeFocused()
  await file.setInputFiles(syntheticFile("empty.txt", ""))
  await expect(dialog.getByRole("alert")).toBeVisible()
  await expect(dialog.getByRole("button", { name: "Tải lên", exact: true })).toBeDisabled()
  await file.setInputFiles(syntheticFile("unsupported.exe"))
  await expect(dialog.getByRole("alert")).toBeVisible()
  await expect(dialog.getByRole("button", { name: "Tải lên", exact: true })).toBeDisabled()
  await page.keyboard.press("Escape")
  await expect(dialog).toHaveCount(0); await expect(trigger).toBeFocused()
  expect(qa.requests.filter(r => r.method !== "GET")).toHaveLength(0)
})

test("pending upload blocks Escape/close/duplicates, then reconciles a real mock201 receipt", async ({ page, qa }) => {
  let release!: () => void, attempts = 0
  const gate = new Promise<void>(resolve => { release = resolve })
  await page.route("**/lifecycle/documents/upload", async route => {
    attempts++; await gate; await route.fallback()
  })
  try {
    await page.goto("/documents")
    const trigger = page.getByRole("button", { name: "Thêm tài liệu", exact: true })
    await trigger.click()
    await page.getByLabel("File tài liệu", { exact: true }).setInputFiles(syntheticFile("browser-upload.txt"))
    await page.getByRole("button", { name: "Tải lên", exact: true }).click()
    await expect.poll(() => attempts).toBe(1)
    const dialog = page.getByRole("dialog", { name: "Thêm tài liệu", exact: true })
    await expect(dialog.locator("form")).toHaveAttribute("aria-busy", "true")
    await expect(dialog.getByRole("button", { name: "Tải lên", exact: true })).toBeDisabled()
    await expect(dialog.getByRole("button", { name: "Đóng", exact: true })).toBeDisabled()
    await page.keyboard.press("Escape"); await expect(dialog).toBeVisible()
    await dialog.getByRole("button", { name: "Close", exact: true }).click()
    await expect(dialog).toBeVisible()
    await expect(dialog).not.toContainText("đã được index")
    expect(attempts).toBe(1)
    const receipt = page.waitForResponse(r => r.request().method() === "POST" && r.url().endsWith("/documents/upload"))
    release()
    expect((await receipt).status()).toBe(201)
    await expect(dialog).toContainText("Phiên bản đã được index và kích hoạt")
    await dialog.getByRole("button", { name: "Đóng", exact: true }).click()
    await expect(trigger).toBeFocused()
    await expect(page.getByRole("button", { name: /browser-upload\.txt/ })).toBeVisible()
    expect(qa.requests.filter(r => r.method === "POST" && r.path.endsWith("/documents/upload"))).toHaveLength(1)
  } finally { release() }
})

for (const width of [320, 375]) {
  test(`${width}px version/re-index/delete dialogs fit short viewport, trap keyboard and cancel without requests`, async ({ page, qa }) => {
    await page.setViewportSize({ width, height: 568 })
    await openDocument(page)
    for (const action of ["Phiên bản mới", "Re-index", "Xóa tài liệu"]) {
      const trigger = detail(page).getByRole("button", { name: action, exact: true })
      await trigger.focus(); await page.keyboard.press("Enter")
      const dialog = page.getByRole("dialog")
      const close = dialog.getByRole("button", { name: "Đóng", exact: true })
      const first = action === "Phiên bản mới" ? dialog.getByLabel("File phiên bản mới", { exact: true }) : close
      await expect(first).toBeFocused()
      if (action === "Phiên bản mới") {
        await first.setInputFiles(syntheticFile("browser-version.txt"))
      }
      await first.focus(); await page.keyboard.press("Shift+Tab"); await expect(confirm(page)).toBeFocused()
      await page.keyboard.press("Tab"); await expect(first).toBeFocused()
      const bounds = await dialog.boundingBox()
      expect(bounds!.x).toBeGreaterThanOrEqual(0)
      expect(bounds!.x + bounds!.width).toBeLessThanOrEqual(width)
      expect(bounds!.y).toBeGreaterThanOrEqual(0)
      expect(bounds!.y + bounds!.height).toBeLessThanOrEqual(568)
      await close.click()
      await expect(dialog).toHaveCount(0); await expect(trigger).toBeFocused()
      await trigger.press("Enter"); await page.keyboard.press("Escape")
      await expect(dialog).toHaveCount(0); await expect(trigger).toBeFocused()
    }
    expect(qa.requests.filter(r => ["PUT", "POST", "DELETE"].includes(r.method))).toHaveLength(0)
  })
}

test("failed version preserves active ID, then confirmed re-index and202/200 cleanup reconcile authoritative state", async ({ page, qa }) => {
  await openDocument(page)
  const original = await activeId(page).textContent()
  await detail(page).getByRole("button", { name: "Phiên bản mới", exact: true }).click()
  await page.getByLabel("File phiên bản mới", { exact: true }).setInputFiles(syntheticFile("qa-fail.txt"))
  await confirm(page).click()
  const dialog = page.getByRole("dialog")
  await expect(dialog.getByRole("alert")).toBeVisible()
  await expect(confirm(page)).toBeDisabled()
  await dialog.getByRole("button", { name: "Đóng", exact: true }).click()
  await expect(activeId(page)).toHaveText(original!)
  await expect(detail(page).getByRole("listitem").filter({ hasText: "Phiên bản 3" })).toContainText("Thất bại")
  await expect(detail(page)).toContainText("Tài liệu INDEXED và có phiên bản hoạt động")
  await detail(page).getByRole("button", { name: "Re-index", exact: true }).click()
  await confirm(page).click()
  await expect(dialog).toContainText("được kích hoạt")
  await dialog.getByRole("button", { name: "Đóng", exact: true }).click()
  await expect(activeId(page)).not.toHaveText(original!)
  await expect(detail(page)).toContainText("Phiên bản 4")
  await detail(page).getByRole("button", { name: "Xóa tài liệu", exact: true }).click()
  await expect(dialog).toContainText("giữ raw files/lịch sử")
  await confirm(page).click(); await expect(dialog).toContainText("HTTP 202")
  await expect(dialog).toContainText("Raw files được giữ")
  await dialog.getByRole("button", { name: "Đóng", exact: true }).click()
  const cleanup = detail(page).getByRole("button", { name: "Thử cleanup lại", exact: true })
  await expect(cleanup).toBeFocused()
  await expect(page.getByRole("list", { name: "Danh sách tài liệu", exact: true })).not.toContainText(filename)
  await cleanup.press("Enter"); await confirm(page).click()
  await expect(dialog).toContainText("HTTP 200")
  await dialog.getByRole("button", { name: "Đóng", exact: true }).click()
  await expect(detail(page).getByRole("button", { name: "Đã soft-delete", exact: true })).toBeDisabled()
  expect(await page.evaluate(() => document.activeElement?.tagName)).not.toBe("BODY")
  await page.getByLabel("Bao gồm tài liệu đã xóa", { exact: true }).check()
  await expect(page.getByRole("button", { name: new RegExp(filename.replaceAll(".", "\\.")) })).toBeVisible()
  expect(qa.requests.filter(r => r.method === "DELETE")).toHaveLength(2)
  expect(qa.requests.filter(r => r.method === "PUT")).toHaveLength(1)
})

test("stale confirmation after another tab re-indexes refreshes detail and sends no DELETE", async ({ page, context, qa }) => {
  await openDocument(page)
  await detail(page).getByRole("button", { name: "Xóa tài liệu", exact: true }).click()
  const remote = await context.newPage()
  await openDocument(remote)
  await detail(remote).getByRole("button", { name: "Re-index", exact: true }).click()
  await confirm(remote).click()
  await expect(remote.getByRole("dialog")).toContainText("được kích hoạt")
  await confirm(page).click()
  await expect(page.getByRole("dialog").getByRole("alert")).toContainText("Tài liệu đã thay đổi")
  await expect(confirm(page)).toBeDisabled()
  expect(qa.requests.filter(r => r.method === "DELETE")).toHaveLength(0)
  await page.getByRole("dialog").getByRole("button", { name: "Đóng", exact: true }).click()
  await expect(detail(page)).toContainText("Phiên bản 3")
  await expect(detail(page).getByRole("button", { name: "Xóa tài liệu", exact: true })).toBeFocused()
  await remote.close()
})

test("successful mutation with failed detail reread retains receipt/warning, no replay; explicit refresh recovers", async ({ page, qa }) => {
  await openDocument(page)
  const original = await activeId(page).textContent()
  let reads = 0
  await page.route(`**/lifecycle/documents/${documentId}`, async route => {
    if (route.request().method() !== "GET" || ++reads !== 2) { await route.fallback(); return }
    await route.fulfill({ status: 503, headers: { "Access-Control-Allow-Origin": "http://127.0.0.1:3100" }, json: { detail: "synthetic reread unavailable" } })
  })
  await detail(page).getByRole("button", { name: "Re-index", exact: true }).click()
  await confirm(page).click()
  const dialog = page.getByRole("dialog")
  await expect(dialog).toContainText("được kích hoạt")
  await expect(dialog.getByRole("alert")).toContainText("Chưa tải lại được chi tiết")
  await expect(confirm(page)).toBeDisabled()
  expect(reads).toBe(2)
  await dialog.getByRole("button", { name: "Đóng", exact: true }).click()
  await expect(activeId(page)).toHaveText(original!)
  await page.getByRole("button", { name: "Làm mới", exact: true }).click()
  await page.getByRole("button", { name: new RegExp(filename.replaceAll(".", "\\.")) }).click()
  await expect(activeId(page)).not.toHaveText(original!)
  expect(qa.requests.filter(r => r.method === "POST" && r.path.endsWith("/re-index"))).toHaveLength(1)
})

test.describe("pending protected action", () => {
  test.use({ apiDelayMs: 250 })
  test("Stop waiting unlocks uncertain state, close guards hold while pending and navigation does not replay", async ({ page, qa }) => {
    await openDocument(page)
    await detail(page).getByRole("button", { name: "Re-index", exact: true }).click()
    await confirm(page).click()
    await expect.poll(() => qa.requests.filter(r => r.method === "POST" && r.path.endsWith("/re-index")).length).toBe(1)
    const dialog = page.getByRole("dialog")
    await expect(dialog.getByRole("button", { name: "Đóng", exact: true })).toBeDisabled()
    await page.keyboard.press("Escape"); await expect(dialog).toBeVisible()
    await dialog.getByRole("button", { name: "Dừng chờ phản hồi", exact: true }).press("Enter")
    await expect(dialog.getByRole("alert")).toContainText("Dịch vụ có thể vẫn xử lý")
    await expect(confirm(page)).toBeDisabled()
    await dialog.getByRole("button", { name: "Đóng", exact: true }).click()
    await page.getByRole("link", { name: "Chat", exact: true }).click()
    await page.getByRole("link", { name: "Tài liệu", exact: true }).click()
    await expect(page.getByRole("button", { name: new RegExp(filename.replaceAll(".", "\\.")) })).toBeVisible()
    expect(qa.requests.filter(r => r.method === "POST" && r.path.endsWith("/re-index"))).toHaveLength(1)
  })
})

test("PROCESSING/FAILED status and active version are separate; protected actions follow actual state", async ({ page, qa }) => {
  await page.goto("/documents")
  await page.getByRole("button", { name: /quy-trinh-ho-tro\.md/ }).click()
  await expect(detail(page)).toContainText("Tài liệu đang xử lý")
  await expect(activeId(page)).toHaveText("Chưa có phiên bản hoạt động")
  await expect(detail(page).getByRole("button", { name: "Phiên bản mới", exact: true })).toBeDisabled()
  await expect(detail(page).getByRole("button", { name: "Re-index", exact: true })).toBeDisabled()
  await page.getByRole("button", { name: /cau-hoi-thuong-gap\.txt/ }).click()
  await expect(detail(page)).toContainText("Trạng thái tài liệu là FAILED")
  await expect(activeId(page)).toHaveText("Chưa có phiên bản hoạt động")
  await expect(detail(page).getByRole("button", { name: "Phiên bản mới", exact: true })).toBeEnabled()
  await expect(detail(page).getByRole("button", { name: "Re-index", exact: true })).toBeDisabled()
  expect(qa.requests.filter(r => r.method !== "GET")).toHaveLength(0)
})
