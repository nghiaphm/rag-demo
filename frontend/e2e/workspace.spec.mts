import { test, expect } from "./fixtures.mjs"

test("session keyboard rename, cancel, current deletion and focus fallback", async ({ page, qa }) => {
  await page.goto("/chat")
  await page.getByRole("button", { name: "Cuộc trò chuyện mới" }).click()
  await expect(page).toHaveURL(/\/chat\/[0-9a-f-]{36}$/)
  const id = page.url().split("/").at(-1)!
  const trigger = page.getByRole("button", { name: "Thao tác với phiên QA new chat" })
  await trigger.focus(); await page.keyboard.press("Enter")
  await page.getByRole("menuitem", { name: "Đổi tên" }).press("Enter")
  await expect(page.getByRole("textbox", { name: "Tên phiên", exact: true })).toBeFocused()
  await page.getByRole("textbox", { name: "Tên phiên", exact: true }).fill("E2E renamed")
  await page.getByRole("button", { name: "Lưu tên", exact: true }).click()
  await expect(page.getByRole("dialog")).toHaveCount(0)
  const renamed = page.getByRole("button", { name: "Thao tác với phiên E2E renamed" })
  await renamed.click(); await page.getByRole("menuitem", { name: "Xóa phiên" }).click()
  await expect(page.getByRole("button", { name: "Hủy", exact: true })).toBeFocused()
  await page.keyboard.press("Escape")
  await expect(page.getByRole("dialog")).toHaveCount(0)
  expect(qa.requests.filter(r => r.method === "DELETE")).toHaveLength(0)
  await renamed.click(); await page.getByRole("menuitem", { name: "Xóa phiên" }).click()
  await page.getByRole("button", { name: "Xác nhận xóa", exact: true }).click()
  await expect(page).toHaveURL(/\/chat$/)
  await expect(page.getByRole("dialog")).toHaveCount(0)
  await expect(page.getByRole("button", { name: "Cuộc trò chuyện mới" })).toBeFocused()
  expect(qa.requests.filter(r => r.method === "DELETE" && r.path.endsWith(id))).toHaveLength(1)
})

test("composer creates a session, three turns persist, refresh restores own history", async ({ page, qa }) => {
  await page.goto("/chat")
  for (let turn = 1; turn <= 3; turn++) {
    await page.getByRole("textbox", { name: "Câu hỏi", exact: true }).fill(`E2E turn ${turn}`)
    await page.getByRole("button", { name: "Gửi câu hỏi", exact: true }).click()
    await expect(page.getByRole("button", { name: "Dừng tạo câu trả lời" })).toBeVisible()
    await expect(page.getByRole("textbox", { name: "Câu hỏi", exact: true })).toHaveAttribute("aria-readonly", "false")
    await expect(page).toHaveURL(/\/chat\/[0-9a-f-]{36}$/)
  }
  await expect(page.getByRole("article", { name: "Câu trả lời của trợ lý", exact: true })).toHaveCount(3)
  const url = page.url()
  await page.reload()
  await expect(page.getByRole("article", { name: "Câu trả lời của trợ lý", exact: true })).toHaveCount(3)
  for (let turn = 1; turn <= 3; turn++) await expect(page.getByText(`E2E turn ${turn}`, { exact: true })).toBeVisible()
  expect(page.url()).toBe(url)
  expect(qa.requests.filter(r => r.method === "POST" && r.path.endsWith("/sessions"))).toHaveLength(1)
  const streams = qa.requests.filter(r => r.method === "POST" && r.path.endsWith("/chat/stream"))
  expect(streams).toHaveLength(3)
  expect(new Set(streams.map(r => JSON.parse(r.body!).session_id)).size).toBe(1)
})

test("Stop preserves partial text, no replay, deliberate history recovery", async ({ page, qa }) => {
  await page.goto("/chat")
  await page.getByRole("textbox", { name: "Câu hỏi", exact: true }).fill("E2E cancel")
  await page.getByRole("button", { name: "Gửi câu hỏi", exact: true }).click()
  await expect(page.getByText("Mock Markdown", { exact: true })).toBeVisible()
  await page.getByRole("button", { name: "Dừng tạo câu trả lời" }).click()
  await expect(page.getByRole("textbox", { name: "Câu hỏi", exact: true })).toHaveAttribute("aria-readonly", "false")
  await expect(page.getByText("Bạn đã dừng tạo câu trả lời.", { exact: true })).toBeVisible()
  await expect(page.getByRole("article", { name: "Câu trả lời của trợ lý", exact: true })).toContainText("Mock Markdown")
  await page.getByRole("link", { name: "Tải lại phiên để kiểm tra lịch sử trước khi gửi lại" }).click()
  await expect(page).toHaveURL(/\/chat\/[0-9a-f-]{36}$/)
  await expect(page.getByText("Chưa hoàn tất", { exact: true })).toBeVisible()
  expect(qa.requests.filter(r => r.method === "POST" && r.path.endsWith("/chat/stream"))).toHaveLength(1)
})

test("post-header error and disconnect terminate loading without automatic retry", async ({ page, qa }) => {
  await page.goto("/chat/aaaaaaaa-1111-4111-8111-111111111111")
  for (const question of ["[error]", "[disconnect]"]) {
    await page.getByRole("textbox", { name: "Câu hỏi", exact: true }).fill(question)
    await page.getByRole("button", { name: "Gửi câu hỏi", exact: true }).click()
    await expect(page.getByRole("textbox", { name: "Câu hỏi", exact: true })).toHaveAttribute("aria-readonly", "false")
  }
  await expect(page.getByRole("link", { name: "Tải lại phiên để kiểm tra lịch sử trước khi gửi lại" })).toBeVisible()
  expect(qa.requests.filter(r => r.method === "POST" && r.path.endsWith("/chat/stream"))).toHaveLength(2)
})

test("document upload/version/re-index/delete202 and deliberate cleanup200", async ({ page, qa }) => {
  await page.goto("/documents")
  await page.getByRole("button", { name: "Thêm tài liệu", exact: true }).click()
  await page.getByLabel("File tài liệu", { exact: true }).setInputFiles({ name: "qa-e2e.txt", mimeType: "text/plain", buffer: Buffer.from("synthetic e2e fixture\n") })
  await page.getByRole("button", { name: "Tải lên", exact: true }).click()
  await expect(page.getByRole("dialog")).toContainText("Phiên bản đã được index và kích hoạt")
  await page.getByRole("button", { name: "Đóng", exact: true }).click()
  await page.getByRole("button", { name: /qa-e2e\.txt/ }).click()
  const detail = page.getByRole("region", { name: "Chi tiết tài liệu" })
  await detail.getByRole("button", { name: "Phiên bản mới", exact: true }).click()
  await page.getByLabel("File phiên bản mới", { exact: true }).setInputFiles({ name: "qa-e2e-version.txt", mimeType: "text/plain", buffer: Buffer.from("version fixture") })
  await page.getByRole("button", { name: "Xác nhận thao tác" }).click()
  await expect(page.getByRole("dialog")).toContainText("được kích hoạt")
  await page.getByRole("button", { name: "Đóng", exact: true }).click()
  await detail.getByRole("button", { name: "Re-index", exact: true }).click()
  await page.getByRole("button", { name: "Xác nhận thao tác" }).click()
  await expect(page.getByRole("dialog")).toContainText("được kích hoạt")
  await page.getByRole("button", { name: "Đóng", exact: true }).click()
  await expect(detail).toContainText("Phiên bản 3")
  await detail.getByRole("button", { name: "Xóa tài liệu", exact: true }).click()
  await page.getByRole("button", { name: "Xác nhận thao tác" }).click()
  await expect(page.getByRole("dialog")).toContainText("HTTP 202")
  await expect(page.getByRole("dialog")).toContainText("Raw files được giữ")
  await page.getByRole("button", { name: "Đóng", exact: true }).click()
  await detail.getByRole("button", { name: "Thử cleanup lại", exact: true }).click()
  await page.getByRole("button", { name: "Xác nhận thao tác" }).click()
  await expect(page.getByRole("dialog")).toContainText("HTTP 200")
  await page.getByRole("button", { name: "Đóng", exact: true }).click()
  await page.getByLabel("Bao gồm tài liệu đã xóa").check()
  await expect(page.getByRole("button", { name: /qa-e2e-version\.txt/ })).toBeVisible()
  expect(qa.requests.filter(r => r.method === "DELETE")).toHaveLength(2)
})

test("REST503 has explicit retry and no request loop", async ({ page, qa }) => {
  qa.profile = "/error"
  await page.goto("/documents")
  const retry = page.getByRole("button", { name: "Thử lại danh sách" })
  await expect(retry).toBeVisible()
  const before = qa.requests.filter(r => r.path.includes("/documents")).length
  expect(before).toBe(1)
  qa.profile = "/lifecycle"
  await retry.click()
  await expect(page.getByRole("button", { name: /so-tay-nhan-vien\.pdf/ })).toBeVisible()
  expect(qa.requests.filter(r => r.path.includes("/documents")).length).toBe(2)
})

test("375px mobile sidebar keyboard open, route selection and Escape close", async ({ page }) => {
  await page.setViewportSize({ width: 375, height: 812 })
  await page.goto("/chat")
  const toggle = page.getByRole("button", { name: "Mở hoặc thu gọn thanh điều hướng" })
  await toggle.focus(); await page.keyboard.press("Enter")
  const sidebar = page.getByRole("dialog")
  await expect(sidebar).toBeVisible()
  await sidebar.getByRole("link", { name: "Tài liệu", exact: true }).click()
  await expect(page).toHaveURL(/\/documents$/)
  await expect(sidebar).toHaveCount(0)
  await toggle.focus(); await page.keyboard.press("Enter")
  await page.keyboard.press("Escape")
  await expect(sidebar).toHaveCount(0)
  await expect(toggle).toBeFocused()
})
