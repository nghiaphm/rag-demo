import { test, expect } from "./fixtures.mjs"

const a = "aaaaaaaa-1111-4111-8111-111111111111"
const b = "bbbbbbbb-1111-4111-8111-111111111111"
const titleA = "QA session A — long history"
const titleB = "QA session B — separate history"

test("desktop Space/arrows/Escape and rename Tab trap, validation, trim and focus return", async ({ page, qa }) => {
  await page.goto(`/chat/${a}`)
  const trigger = page.getByRole("button", { name: `Thao tác với phiên ${titleA}` })
  await trigger.focus(); await page.keyboard.press("Space")
  await expect(page.getByRole("menuitem", { name: "Đổi tên" })).toBeFocused()
  await page.keyboard.press("ArrowDown")
  await expect(page.getByRole("menuitem", { name: "Xóa phiên" })).toBeFocused()
  await page.keyboard.press("ArrowUp")
  await expect(page.getByRole("menuitem", { name: "Đổi tên" })).toBeFocused()
  await page.keyboard.press("Escape")
  await expect(trigger).toBeFocused()
  await page.keyboard.press("Enter")
  await page.getByRole("menuitem", { name: "Đổi tên" }).press("Enter")
  const input = page.getByRole("textbox", { name: "Tên phiên", exact: true })
  const save = page.getByRole("button", { name: "Lưu tên", exact: true })
  await expect(input).toBeFocused()
  await page.keyboard.press("Shift+Tab"); await expect(save).toBeFocused()
  await page.keyboard.press("Tab"); await expect(input).toBeFocused()
  await input.fill("   "); await expect(save).toBeDisabled()
  await input.fill("😀".repeat(201)); await expect(save).toBeDisabled()
  expect(qa.requests.filter(r => r.method === "PATCH")).toHaveLength(0)
  await input.fill("  Keyboard renamed 😀  "); await save.click()
  await expect(page.getByRole("dialog")).toHaveCount(0)
  const renamed = page.getByRole("button", { name: "Thao tác với phiên Keyboard renamed 😀" })
  await expect(renamed).toBeFocused()
  await expect(page.locator(`a[href='/chat/${a}']`)).toHaveAttribute("aria-current", "page")
  expect(qa.requests.filter(r => r.method === "PATCH").map(r => [r.path, JSON.parse(r.body!)])).toEqual([
    [`/lifecycle/sessions/${a}`, { title: "Keyboard renamed 😀" }],
  ])
})

test("60 sessions pagination, explicit refresh and other-session deletion reconcile without changing route", async ({ page, qa }) => {
  qa.profile = "/many"
  await page.goto(`/chat/${a}`)
  await expect(page.getByText("Hiển thị 50/60 phiên.", { exact: true })).toBeVisible()
  await page.getByRole("button", { name: "Tải thêm phiên", exact: true }).click()
  await expect(page.locator("a[href^='/chat/']")).toHaveCount(60)
  await expect(page.getByRole("button", { name: "Tải thêm phiên", exact: true })).toHaveCount(0)
  expect(await page.locator("a[href^='/chat/']").evaluateAll(links => new Set(links.map(l => l.getAttribute("href"))).size)).toBe(60)
  await page.getByRole("button", { name: `Thao tác với phiên ${titleB}` }).click()
  await page.getByRole("menuitem", { name: "Xóa phiên" }).click()
  await page.getByRole("button", { name: "Xác nhận xóa", exact: true }).click()
  await expect(page.getByRole("dialog")).toHaveCount(0)
  await expect(page).toHaveURL(new RegExp(`/chat/${a}$`))
  await expect(page.locator(`a[href='/chat/${a}']`)).toHaveAttribute("aria-current", "page")
  await expect(page.locator(`a[href='/chat/${b}']`)).toHaveCount(0)
  await expect(page.getByText("Hiển thị 50/59 phiên.", { exact: true })).toBeVisible()
  await page.getByRole("button", { name: "Tải thêm phiên", exact: true }).click()
  await expect(page.locator("a[href^='/chat/']")).toHaveCount(59)
  await page.getByRole("button", { name: "Làm mới phiên", exact: true }).click()
  await expect(page.getByText("Hiển thị 50/59 phiên.", { exact: true })).toBeVisible()
  expect(qa.requests.filter(r => r.method === "DELETE").map(r => r.path)).toEqual([`/lifecycle/sessions/${b}`])
})

for (const width of [320, 375]) {
  test(`${width}px session dialog keyboard containment, cancel and nested sidebar focus return`, async ({ page, qa }) => {
    await page.setViewportSize({ width, height: 812 })
    await page.goto(`/chat/${a}`)
    const toggle = page.getByRole("button", { name: "Mở hoặc thu gọn thanh điều hướng" })
    await toggle.click()
    const trigger = page.getByRole("button", { name: `Thao tác với phiên ${titleB}` })
    await trigger.focus(); await page.keyboard.press("Enter")
    await page.getByRole("menuitem", { name: "Xóa phiên" }).press("Enter")
    const dialog = page.getByRole("dialog", { name: "Xác nhận xóa phiên trò chuyện" })
    await expect(dialog).toBeVisible()
    const cancel = dialog.getByRole("button", { name: "Hủy", exact: true })
    const confirm = dialog.getByRole("button", { name: "Xác nhận xóa", exact: true })
    await expect(cancel).toBeFocused()
    await page.keyboard.press("Shift+Tab"); await expect(confirm).toBeFocused()
    await page.keyboard.press("Tab"); await expect(cancel).toBeFocused()
    const bounds = await dialog.boundingBox()
    expect(bounds!.x).toBeGreaterThanOrEqual(0)
    expect(bounds!.x + bounds!.width).toBeLessThanOrEqual(width)
    await page.keyboard.press("Escape")
    await expect(dialog).toHaveCount(0); await expect(trigger).toBeFocused()
    await page.keyboard.press("Escape"); await expect(toggle).toBeFocused()
    await expect(page).toHaveURL(new RegExp(`/chat/${a}$`))
    expect(qa.requests.filter(r => ["PATCH", "DELETE"].includes(r.method))).toHaveLength(0)
  })
}

test.describe("remote active-generation guard", () => {
  test.use({ streamDelayMs: 400 })
  test("DELETE409 preserves active route/row and requires deliberate review, without replay", async ({ page, context, qa }) => {
    await page.goto(`/chat/${a}`)
    const remote = await context.newPage()
    await remote.goto(`/chat/${a}`)
    await remote.getByRole("textbox", { name: "Câu hỏi", exact: true }).fill("remote generation guard fixture")
    await remote.getByRole("button", { name: "Gửi câu hỏi", exact: true }).click()
    await expect(remote.getByRole("article", { name: "Câu trả lời của trợ lý", exact: true }).last()).toContainText("Mock Markdown")
    await page.getByRole("button", { name: `Thao tác với phiên ${titleA}` }).click()
    await page.getByRole("menuitem", { name: "Xóa phiên" }).click()
    const response = page.waitForResponse(r => r.request().method() === "DELETE" && r.url().endsWith(a))
    await page.getByRole("button", { name: "Xác nhận xóa", exact: true }).click()
    expect((await response).status()).toBe(409)
    const dialog = page.getByRole("dialog", { name: "Xác nhận xóa phiên trò chuyện" })
    await expect(dialog.getByRole("alert")).toBeVisible()
    await expect(dialog.getByRole("button", { name: "Xác nhận xóa", exact: true })).toBeDisabled()
    await expect(page).toHaveURL(new RegExp(`/chat/${a}$`))
    await dialog.getByRole("button", { name: "Làm mới danh sách", exact: true }).click()
    await expect(dialog).toHaveCount(0)
    await expect(page.locator(`a[href='/chat/${a}']`)).toHaveAttribute("aria-current", "page")
    await remote.getByRole("button", { name: "Dừng tạo câu trả lời" }).click()
    await expect(remote.getByRole("textbox", { name: "Câu hỏi", exact: true })).toHaveAttribute("aria-readonly", "false")
    expect(qa.requests.filter(r => r.method === "DELETE")).toHaveLength(1)
    await remote.close()
  })
})
