import { test, expect } from "./fixtures.mjs"
import type { Locator, Page } from "@playwright/test"
import { fileURLToPath } from "node:url"

const greeting = "Xin chào! Tôi là trợ lý tri thức nội bộ. Bạn muốn tìm hiểu điều gì hôm nay?"
const welcome = (page: Page) => page.getByRole("heading", { name: greeting, exact: true })
const question = (page: Page) => page.getByRole("textbox", { name: "Câu hỏi", exact: true })
const picker = (page: Page) => page.locator('form:visible input[type="file"][aria-label="Chọn tệp đính kèm"]')
const handle = (page: Page) => page.getByRole("separator", { name: "Điều chỉnh chiều rộng xem trước tài liệu" })
const width = async (panel: Locator) => (await panel.boundingBox())!.width
const file = (name = "resize.txt") => ({ name, mimeType: name.endsWith(".pdf") ? "application/pdf" : "text/plain", buffer: Buffer.from("Preview line\n".repeat(200)) })

async function openPreview(page: Page) {
  await page.goto("/chat")
  await picker(page).setInputFiles(file())
  await expect(page.getByRole("list", { name: "Tệp đính kèm" })).toContainText("Ready")
  await page.getByRole("button", { name: "Xem trước resize.txt", exact: true }).click()
  const panel = page.getByRole("dialog", { name: "resize.txt", exact: true })
  await expect(panel.getByLabel("Nội dung tài liệu")).toBeVisible()
  return panel
}

async function drag(page: Page, delta: number) {
  // Wait for the Sheet's opening transition before using absolute coordinates.
  await handle(page).hover()
  const box = (await handle(page).boundingBox())!
  await page.mouse.move(box.x + box.width / 2, box.y + 200)
  await expect(handle(page)).toHaveCSS("cursor", "col-resize")
  await page.mouse.down()
  await page.mouse.move(box.x + box.width / 2 + delta, box.y + 200, { steps: 8 })
  await page.mouse.up()
}

test("New Chat and empty session greet locally; first turn, refresh and session switching show real history", async ({ page, qa }) => {
  await page.goto("/chat")
  await expect(welcome(page)).toBeVisible()
  await page.screenshot({ path: ".playwright-tmp/ux-welcome-desktop.png" })
  await expect(page.getByRole("article")).toHaveCount(0)
  expect(qa.requests.filter(r => r.method === "POST")).toHaveLength(0)
  await page.getByRole("button", { name: "Cuộc trò chuyện mới", exact: true }).click()
  await expect(page).toHaveURL(/\/chat\/[0-9a-f-]{36}$/)
  const sessionUrl = page.url()
  await expect(welcome(page)).toBeVisible()
  await page.reload()
  await expect(welcome(page)).toBeVisible()
  expect(qa.requests.filter(r => r.method === "POST").map(r => r.path)).toEqual(["/lifecycle/sessions"])
  await question(page).fill("First real question")
  await page.getByRole("button", { name: "Gửi câu hỏi", exact: true }).click()
  await expect(page.getByRole("article", { name: "Tin nhắn của bạn", exact: true })).toContainText("First real question")
  await expect(welcome(page)).toHaveCount(0)
  await expect(question(page)).toHaveValue("")
  const response = page.waitForResponse(r => r.url().includes("/messages?") && r.request().method() === "GET")
  await page.reload()
  const history = await (await response).json()
  expect(history.items).toHaveLength(2)
  expect(history.items.some((m: { content: string }) => m.content.includes(greeting))).toBe(false)
  await expect(welcome(page)).toHaveCount(0)
  await expect(page.getByRole("article")).toHaveCount(2)
  await page.getByRole("link", { name: "QA session B — separate history", exact: true }).click()
  await expect(page.getByRole("article").first()).toContainText("QA question")
  await expect(welcome(page)).toHaveCount(0)
  await page.goto(sessionUrl)
  await expect(page.getByRole("article").first()).toContainText("First real question")
  expect(qa.requests.filter(r => r.path.endsWith("/chat/stream"))).toHaveLength(1)
})

test("loading or failed history never renders the welcome state", async ({ page }) => {
  let release!: () => void
  const gate = new Promise<void>(resolve => { release = resolve })
  await page.route("**/sessions/*/messages?*", async route => { await gate; await route.fallback() })
  try {
    await page.goto("/chat/bbbbbbbb-1111-4111-8111-111111111111")
    await expect(page.getByRole("heading", { name: "Đang tải lịch sử trò chuyện" })).toBeVisible()
    await expect(welcome(page)).toHaveCount(0)
    release()
    await expect(page.getByRole("article")).toHaveCount(2)
    await expect(welcome(page)).toHaveCount(0)
  } finally { release() }
  await page.route("**/sessions/*/messages?*", route => route.fulfill({ status: 503, json: { detail: "mock failure" } }))
  await page.reload()
  await expect(page.getByRole("heading", { name: "Không thể tải lịch sử trò chuyện" })).toBeVisible()
  await expect(welcome(page)).toHaveCount(0)
})

test("preview keeps default width; left/right drags resize, reopen and message preview restore the preference", async ({ page, qa }) => {
  const panel = await openPreview(page)
  await expect.poll(() => width(panel)).toBe(576)
  await drag(page, -150)
  await expect.poll(() => width(panel)).toBe(726)
  await drag(page, 70)
  await expect.poll(() => width(panel)).toBe(656)
  await panel.getByRole("button", { name: "Đóng xem trước", exact: true }).click()
  await expect(panel).toHaveCount(0)
  await page.getByRole("button", { name: "Xem trước resize.txt", exact: true }).click()
  await expect.poll(() => width(panel)).toBe(656)
  await page.keyboard.press("Escape")
  await expect(page.getByRole("button", { name: "Xem trước resize.txt", exact: true })).toBeFocused()
  await question(page).fill("Keep preview attached")
  await page.getByRole("button", { name: "Gửi câu hỏi", exact: true }).click()
  await expect(page).toHaveURL(/\/chat\/[0-9a-f-]{36}$/)
  await page.getByRole("button", { name: "Xem tệp đính kèm resize.txt", exact: true }).click()
  await expect.poll(() => width(panel)).toBe(656)
  await expect(panel.getByLabel("Nội dung tài liệu")).toContainText("Preview line")
  await expect(panel).toHaveCSS("opacity", "1")
  await page.screenshot({ path: ".playwright-tmp/ux-preview-desktop.png" })
  await page.keyboard.press("Escape")
  await page.reload()
  await page.getByRole("button", { name: "Xem tệp đính kèm resize.txt", exact: true }).click()
  await expect.poll(() => width(panel)).toBe(656)
  expect(qa.requests.filter(r => r.method === "DELETE")).toEqual([])
})

test("keyboard and pointer bounds, viewport clamping and mobile preserve usable previews", async ({ page }) => {
  const panel = await openPreview(page)
  const separator = handle(page)
  await separator.focus()
  await separator.press("ArrowLeft")
  await expect.poll(() => width(panel)).toBe(592)
  await separator.press("ArrowRight")
  await expect.poll(() => width(panel)).toBe(576)
  await separator.press("Home")
  await expect.poll(() => width(panel)).toBe(320)
  await drag(page, 600)
  await expect.poll(() => width(panel)).toBe(320)
  await separator.press("End")
  await expect.poll(() => width(panel)).toBe(960)
  await drag(page, -250)
  await expect.poll(() => width(panel)).toBe(960)
  await expect(separator).toHaveAttribute("aria-valuenow", "960")
  await page.setViewportSize({ width: 800, height: 700 })
  await expect.poll(() => width(panel)).toBe(600)
  await expect(separator).toHaveAttribute("aria-valuemax", "600")
  await page.setViewportSize({ width: 375, height: 812 })
  await expect(separator).toHaveCount(0)
  await expect.poll(() => width(panel)).toBeLessThanOrEqual(375)
  await expect(panel.getByLabel("Nội dung tài liệu")).toBeVisible()
  await page.screenshot({ path: ".playwright-tmp/ux-preview-mobile.png" })
  expect(await panel.evaluate(node => node.scrollWidth <= node.clientWidth)).toBe(true)
  const scrollable = panel.locator(".overflow-y-auto")
  await scrollable.evaluate(node => { node.scrollTop = node.scrollHeight })
  expect(await scrollable.evaluate(node => node.scrollTop)).toBeGreaterThan(0)
  await page.setViewportSize({ width: 1280, height: 800 })
  await expect.poll(() => width(panel)).toBe(960)
  await page.keyboard.press("Escape")
})

test("PDF preview retains its existing unsupported-format notice and resizes safely", async ({ page }) => {
  await page.goto("/chat")
  await picker(page).setInputFiles(file("preview.pdf"))
  await expect(page.getByRole("list", { name: "Tệp đính kèm" })).toContainText("Ready")
  await page.getByRole("button", { name: "Xem trước preview.pdf", exact: true }).click()
  const panel = page.getByRole("dialog", { name: "preview.pdf", exact: true })
  await expect(panel).toContainText("Chưa hỗ trợ xem trước định dạng này")
  await drag(page, -100)
  await expect.poll(() => width(panel)).toBe(676)
  await expect(panel).toContainText("Chưa hỗ trợ xem trước định dạng này")
})

test("Excel tables remain read-only and bounded when the panel is narrowed or widened", async ({ page }) => {
  await page.goto("/chat")
  await picker(page).setInputFiles(fileURLToPath(new URL("../../data/documents/enterprise_it_knowledge_base.xlsx", import.meta.url)))
  await expect(page.getByRole("list", { name: "Tệp đính kèm" })).toContainText("Ready")
  await page.getByRole("button", { name: "Xem trước enterprise_it_knowledge_base.xlsx", exact: true }).click()
  const panel = page.getByRole("dialog", { name: "enterprise_it_knowledge_base.xlsx", exact: true })
  const table = panel.getByRole("region", { name: "Sheet Vehicles", exact: true })
  await expect(table).toContainText("Airplane")
  await handle(page).press("Home")
  await expect.poll(() => width(panel)).toBe(320)
  expect(await panel.evaluate(node => node.scrollWidth <= node.clientWidth)).toBe(true)
  await handle(page).press("End")
  await expect.poll(() => width(panel)).toBe(960)
  await expect(table).toContainText("900")
  await expect(panel.getByRole("textbox")).toHaveCount(0)
})
