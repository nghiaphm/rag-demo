# Public browser-reachable FastAPI base URL; never put credentials here.
# Copy to frontend/.env.local. Restart next dev after changing it.
# Production: set the intended URL BEFORE npm run build; rebuild to change it.
NEXT_PUBLIC_API_BASE_URL=http://127.0.0.1:8000

# Provider-free local demo: run node scripts/qa-mock-api.mjs, then use:
# NEXT_PUBLIC_API_BASE_URL=http://127.0.0.1:4011/lifecycle
